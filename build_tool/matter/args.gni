# Options from standalone-chip.mk that differ from configure defaults. These
# options are used from examples/.

import("//build_overrides/chip.gni")

chip_device_platform = "beken"

chip_project_config_include = ""
chip_system_project_config_include = ""
chip_ble_project_config_include = ""
matter_enable_tracing_support = true

mbedtls_target = "${chip_root}/config/beken/mbedtls:mbedtls"
lwip_platform = "external"

chip_build_tests = false

chip_inet_config_enable_tcp_endpoint = false
chip_inet_config_enable_udp_endpoint = true
chip_inet_config_enable_ipv4 = false

chip_progress_logging = true
chip_detail_logging = true
chip_automation_logging = true

chip_config_network_layer_ble = true
chip_config_memory_management = "platform"
chip_enable_additional_data_advertising = false
chip_enable_rotating_device_id = true
chip_enable_ota_requestor = true
chip_enable_wifi=false
chip_with_lwip=false
chip_mdns_platform=true
chip_enable_openthread=true
chip_system_config_use_openthread_inet_endpoints = true
chip_use_transitional_device_instance_info_provider = false
chip_use_transitional_commissionable_data_provider = false
chip_enable_icd_server = false
# Out-of-tree app: allow //zap to depend on CHIP codegen internals.
chip_app_data_model_target = "//zap"
chip_openthread_target="${chip_root}/config/beken/mbedtls:mbedtls"
#openthread_root="${chip_root}/../../openthread/openthread"
custom_toolchain = "${chip_root}/config/beken/toolchain:beken"
